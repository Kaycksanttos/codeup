# Copie este arquivo para ".env" e preencha. NUNCA publique o .env.
PORT=3000
BASE_URL=http://localhost:3000        # em produção: https://seu-dominio.com.br

# --- Seus dados (aparecem em Termos, Privacidade e Perfil) ---
COMPANY_NAME=CodeUp
CONTACT_EMAIL=suporte@seu-dominio.com.br

# --- Banco de dados. Com DATABASE_URL os dados vão para o PostgreSQL (use em produção: Render, Supabase, Neon...).
# Sem ela, usa o arquivo data.json (só para testar no seu computador). Ao ligar o Postgres pela 1ª vez, o data.json antigo é importado sozinho.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# --- Anúncios (Google AdSense). O app é gratuito e se sustenta com anúncios. O jeito mais fácil é pelo painel do dono (/admin → Ajustes → Anúncios);
#     as variáveis abaixo são opcionais (o que for salvo no painel vale mais que elas). Sem nada configurado, nenhum anúncio aparece.
# ADSENSE_CLIENT=ca-pub-0000000000000000     (seu ID de editor, em adsense.google.com)
# ADSENSE_SLOT=0000000000                    (ID do bloco de anúncio "display responsivo" que você criar no AdSense)
# ADS_PREVIEW=1                              (só no seu computador: mostra caixas cinzas no lugar dos anúncios)

# --- Login com Google: o "ID do cliente" do Google Cloud (passo a passo no README). Sem ele, o botão não aparece ---
# GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# --- E-mail (recuperação de senha). Use UMA das opções. Sem nenhuma, o link aparece só no console do servidor ---
# Opção A (mais simples) — Resend: crie a conta em resend.com, verifique seu domínio e gere uma chave de API
# RESEND_API_KEY=re_...
# Opção B — qualquer SMTP (Brevo, Amazon SES, Gmail com senha de app...)
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# Remetente (o domínio precisa estar verificado no provedor):
# MAIL_FROM="CodeUp <no-reply@seu-dominio.com.br>"

# --- Só para TESTAR a recuperação sem e-mail: devolve o link na própria tela. APAGUE em produção! ---
# DEV_SHOW_RESET_LINK=1

# --- Painel do dono (abre em /admin): é a senha que você digita lá. Use 16+ caracteres. ---
# Sem ela o painel fica desligado em produção; no seu computador o servidor gera uma e mostra no terminal.
# ADMIN_KEY=troque-por-uma-chave-longa
# Ou, se preferir uma entrada fixa com e-mail e senha (a tela do painel passa a pedir os dois). ADMIN_PASSWORD vale como a ADMIN_KEY:
# ADMIN_EMAIL=seu@email.com
# ADMIN_PASSWORD=troque-por-uma-senha-longa
# Opcional (produção): endereço só do painel, ex.: admin.seusite.com.br (sem https://). Aí /admin some do site público. Veja o README, seção 5b.
# ADMIN_HOST=admin.seusite.com.br
# Opcional: seu WhatsApp (com DDD). O botão "Enviar pelo WhatsApp" da tela "Ligar o autenticador" já abre a conversa com este número.
# ADMIN_WHATSAPP=11999990000

# Perdeu o celular do autenticador do painel? Crie esta variável, reinicie, entre só com a chave, desligue e ligue o autenticador de novo e depois APAGUE esta linha.
# ADMIN_2FA_OFF=1

# --- Onde guardar os dados (em produção aponte para um disco persistente) ---
# DATA_FILE=/data/data.json

# --- Confirmação de e-mail: fica ligada sozinha quando há e-mail configurado (acima). Sem e-mail, as contas novas entram sem confirmar.
# --- Python no servidor: ligado sozinho se houver python3 (o Dockerfile já instala). PY_SERVER_CHECK=0 desliga.
# PY_SERVER_CHECK=1

# Dias sem entrar para o personagem aparecer dormindo quando o aluno volta (padrão 3)
# AWAY_DAYS=3
